rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own profile doc and their own
    // saved-podcast library subcollection.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /library/{podcastId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
