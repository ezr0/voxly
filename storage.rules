rules_version = '2';

// Not used by the app yet (no avatar/upload feature is built), but scoped
// per-user ahead of time so any future upload feature is safe by default.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
